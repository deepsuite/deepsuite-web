# All values are public and baked in at build time (the site is a static
# export). In CI, set them as GitHub Actions repository *variables*.

# Canonical site origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://deepsuite.app

# Public contact address shown in the footer and contact page. Leave empty
# until a monitored inbox exists — the UI hides the address when unset.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional scheduling link (Cal.com, Calendly, HubSpot Meetings…), offered
# after a successful enquiry.
NEXT_PUBLIC_SCHEDULING_URL=

# Endpoint that receives consultation enquiries as a JSON POST (e.g. a form
# service such as Formspree, a Cloudflare Worker, or a CRM webhook that allows
# CORS from the site origin). When unset, the form validates but tells the
# visitor plainly that nothing was sent.
NEXT_PUBLIC_CONSULTATION_ENDPOINT=
